root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Arquivos em lote do Windows precisam de CRLF.
# Com apenas LF, o "goto" e os rotulos (":nome") deixam de funcionar.
[*.cmd]
end_of_line = crlf
